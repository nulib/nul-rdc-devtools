#!/bin/bash

if [ -n "$AWS_PROFILE" ]; then
  SECRET=$(cut -d "-" -f 1 <<< $AWS_PROFILE)/infrastructure/aurora
else
  SECRET="dev-environment/infrastructure/db"
fi

secrets=$(aws secretsmanager get-secret-value --secret-id $SECRET --query SecretString --output text)

get_parameter() {
  jq -r ".${1}" <<< $secrets
}

export PGHOST=$(get_parameter host)
export PGPORT=$(get_parameter port)
export PGUSER=$(get_parameter username)
export PGPASSWORD=$(get_parameter password)